<http://purl.obolibrary.org/obo/CHMO_0000025> a owl:Class;
  rdfs:subClassOf ofbo:OFBO_0008500;
  rdfs:comment "This CHMO technique is reused by OFBO as a subclass of experimental process and therefore as a planned process."@en;
  rdfs:isDefinedBy <http://purl.obolibrary.org/obo/chmo.owl>;
  rdfs:label "cyclic voltammetry"@en;
  skos:definition "A voltammetry in which the potential is varied linearly and inverts at the end point resulting in a cycle."@en .

ofbo:OFBO_0008500 a owl:Class .

<http://purl.obolibrary.org/obo/CHMO_0000028> a owl:Class;
  rdfs:subClassOf ofbo:OFBO_0008500;
  rdfs:comment "This CHMO technique is reused by OFBO as a subclass of experimental process and therefore as a planned process."@en;
  rdfs:isDefinedBy <http://purl.obolibrary.org/obo/chmo.owl>;
  rdfs:label "linear-sweep voltammetry"@en;
  skos:definition "A \"voltammetry in which [...] the potential is varied linearly\" and stops at an end point."@en .

<http://purl.obolibrary.org/obo/CHMO_0001253> a owl:Class;
  rdfs:subClassOf ofbo:OFBO_0008500;
  rdfs:comment "This CHMO technique is reused by OFBO as a subclass of experimental process and therefore as a planned process."@en;
  rdfs:isDefinedBy <http://purl.obolibrary.org/obo/chmo.owl>;
  rdfs:label "ultraviolet spectrophotometry"@en;
  skos:definition "Spectroscopy where the sample absorbs radiation from the ultraviolet region (190–400 nm) resulting in electronic transitions within the sample."@en .

<http://purl.obolibrary.org/obo/CHMO_0002631> a owl:Class;
  rdfs:subClassOf ofbo:OFBO_0008500;
  rdfs:comment "This CHMO technique is reused by OFBO as a subclass of experimental process and therefore as a planned process."@en;
  rdfs:isDefinedBy <http://purl.obolibrary.org/obo/chmo.owl>;
  rdfs:label "rotating-disk voltammetry"@en;
  skos:definition "An electrochemical technique where the cell current is measured as a function of time and as a function of the potential between the indicator and reference electrodes. The indicator electrode (e.g. a Pt disc of 1.0 mm diameter sealed in a Teflon carrier ) spins at high speed during the experiment, and the rotational motion sets up a well-defined flow of analyte towards its surface."@en .
