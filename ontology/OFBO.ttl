<https://w3id.org/ofbo> rdf:type owl:Ontology ;
                         owl:versionIRI <https://w3id.org/ofbo/1.2.0> ;
                         owl:imports <https://w3id.org/ofbo/qudt-subset> ,
                                     <https://w3id.org/ofbo/imports/chmo-subset> ,
                                     <https://w3id.org/ofbo/imports/mdo-subset> ,
                                     <https://w3id.org/ofbo/imports/prov-o-subset> ;
                         dcterms:contributor <https://orcid.org/0000-0001-5399-043X> ,
                                             <https://orcid.org/0000-0002-0885-5762> ,
                                             <https://orcid.org/0000-0003-2260-8271> ,
                                             <https://orcid.org/0009-0007-4215-324X> ,
                                             <https://orcid.org/0009-0008-7608-2192> ;
                         dcterms:created "2026-09-30"^^xsd:date ;
                         dcterms:creator <https://orcid.org/0000-0001-9923-9676> ;
                         dcterms:description "An ontology for representing molecular, electrochemical, thermodynamic, computational, and provenance information relevant to organic flow-battery electrolyte research."@en ;
                         dcterms:issued "2026-09-30"^^xsd:date ;
                         dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                         dcterms:publisher <https://www.scai.fraunhofer.de/> ;
                         dcterms:source <https://github.com/rfb-predictor/OFBO> ;
                         dcterms:title "Organic Flow Battery Ontology"@en ;
                         vann:preferredNamespacePrefix "ofbo" ;
                         vann:preferredNamespaceUri "https://w3id.org/ofbo#" ;
                         schema1:funding <https://www.rfb-predictor.eu/> ;
                         owl:versionInfo "1.2.0" ;
                         mod:status "active"@en .

