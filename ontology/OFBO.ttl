###  https://w3id.org/ofbo#canonicalUnit
ofbo:canonicalUnit rdf:type owl:AnnotationProperty ;
                   rdfs:label "canonical unit"@en ;
                   skos:definition "Relates an OFBO property class to the QUDT unit used as the canonical unit for numerical comparison and cross-study querying."@en ;
                   rdfs:range qudt:Unit .


###  https://w3id.org/ofbo#relevance
ofbo:relevance rdf:type owl:AnnotationProperty ;
               rdfs:label "relevance"@en ;
               skos:definition """The annotation property relevance links an entity, property, method, or measurement to a textual explanation of its significance or importance in a specific context.

It is used to provide contextual justification, for example, explaining why a property or method is important for (organic) redox flow batteries (RFBs) or other application domains.""" ;
               rdfs:subPropertyOf rdfs:comment .


###  https://w3id.org/ofbo#rfbLiterature
ofbo:rfbLiterature rdf:type owl:AnnotationProperty ;
                   rdfs:label "RFB literature"@en ;
                   skos:definition """The annotation property rfbLiterature links a property, method, or entity to bibliographic references (e.g., DOI) of papers relevant to organic redox flow batteries (ORFBs).

It is used to document sources where the property, descriptor, or method is discussed or demonstrated in the context of ORFBs, allowing users to trace evidence and supporting literature for a given feature.""" ;
                   rdfs:subPropertyOf rdfs:comment .


