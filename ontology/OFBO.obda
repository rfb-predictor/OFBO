source		SELECT
			ID,
			SMILES,
			IUPACName,
			CoreSMILES,
			InChIKey,
			"B3LYP/6-31G*ΔE_R[kJmol-1]Ox" AS DE_R_Ox,
			"B3LYP/6-31G*ΔE_int[kJmol-1]Ox" AS DE_int_Ox,
			"B3LYP/6-31G*ΔE_R[kJmol-1]Red"  AS DE_R_Red,
			"B3LYP/6-31G*ΔE_int[kJmol-1]Red" AS DE_int_Red,
			"Standard_reduction_potential[VvsSHE]" AS E0_VvsSHE,
			Stability_against_bromination,
			Stability_upon_reduction,
			SMILES_ox_brominated,
			SMILES_red_red,
			SMILES_br_red
			FROM OFBO."10_1002aenm_201601488"

