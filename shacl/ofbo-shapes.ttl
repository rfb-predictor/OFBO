@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ofbo: <https://w3id.org/ofbo#> .
@prefix schema: <http://schema.org/> .
@prefix sio: <http://semanticscience.org/resource/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#
# 1. Molecular entities should have at least one representation.
#
#################################################################

ofbo:MoleculeRepresentationShape
    a sh:NodeShape ;
    sh:targetClass ofbo:OFBO_0000012 ;
    sh:or (
        [
            sh:property [
                sh:path schema:smiles ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path schema:inChIKey ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path schema:iupacName ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:message "A molecule must have at least one representation: SMILES, InChIKey, or IUPAC name."@en .

#################################################################
#
# 2. Any entity with a numeric value must also have a unit.
#
#################################################################

ofbo:NumericValueUnitShape
    a sh:NodeShape ;
    sh:targetSubjectsOf qudt:numericValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "A numeric result must have exactly one decimal numeric value."@en
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "An entity with a numeric value must have exactly one unit IRI."@en
    ] .

#################################################################
#
# 3. Redox-potential results must have essential context.
#
#################################################################

ofbo:RedoxPotentialShape
    a sh:NodeShape ;
    sh:targetClass ofbo:OFBO_0001104 ;
    sh:property [
        sh:path sio:SIO_000011 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A redox-potential result must be attributed to exactly one bearer."@en
    ] ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "A redox-potential result must have exactly one decimal numeric value."@en
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A redox-potential result must have exactly one unit IRI."@en
    ] ;
    sh:property [
        sh:path ofbo:OFBO_0009202 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A redox-potential result must have exactly one potential reference, such as SHE or NHE."@en
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A redox-potential result must identify exactly one generating process."@en
    ] .

#################################################################
#
# 4. Every object used as a generating process must be a PROV activity.
#
#################################################################

ofbo:GeneratingProcessShape
    a sh:NodeShape ;
    sh:targetObjectsOf prov:wasGeneratedBy ;
    sh:class prov:Activity ;
    sh:nodeKind sh:IRI ;
    sh:message "An entity that generates a result must be identified as a PROV activity."@en .