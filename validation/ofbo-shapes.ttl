ofbo:OFBO_0004001_CanonicalUnitShape
    a sh:NodeShape ;
    sh:targetClass ofbo:OFBO_0004001 ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:GM-PER-CentiM3 ;
        sh:message "Density must use unit:GM-PER-CentiM3."@en
    ] .

ofbo:OFBO_0004002_CanonicalUnitShape
    a sh:NodeShape ;
    sh:targetClass ofbo:OFBO_0004002 ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliPA-SEC ;
        sh:message "Viscosity must use unit:MilliPA-SEC."@en
    ] .

