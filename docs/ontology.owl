    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt/numericValue -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/numericValue">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ofbo#OFBO_0000020"/>
                    <rdf:Description rdf:about="https://w3id.org/ofbo#OFBO_0000033"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/stringValue -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/stringValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/algorithm -->


    <owl:DatatypeProperty rdf:about="http://schema.org/algorithm">
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0008002"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>algorithm</rdfs:label>
        <skos:definition>The algorithm or rules to follow to compute the score.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/chemicalComposition -->


    <owl:DatatypeProperty rdf:about="http://schema.org/chemicalComposition">
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0000010"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>chemical composition</rdfs:label>
        <skos:definition>The chemical composition describes the identity and relative ratio of the chemical elements that make up the substance.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/hasRepresentation -->


    <owl:DatatypeProperty rdf:about="http://schema.org/hasRepresentation">
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0000010"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has representation</rdfs:label>
        <skos:definition>A common representation such as a protein sequence or chemical structure for this entity. For images use schema.org/image.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/inChIKey -->


    <owl:DatatypeProperty rdf:about="http://schema.org/inChIKey">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/hasRepresentation"/>
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0000010"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>inchikey</rdfs:label>
        <skos:definition>InChIKey is a hashed version of the full InChI (using the SHA-256 algorithm).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/iupacName -->


    <owl:DatatypeProperty rdf:about="http://schema.org/iupacName">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/hasRepresentation"/>
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0000010"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>iupac name</rdfs:label>
        <skos:definition>Systematic method of naming chemical compounds as recommended by the International Union of Pure and Applied Chemistry (IUPAC).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/smiles -->


    <owl:DatatypeProperty rdf:about="http://schema.org/smiles">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/hasRepresentation"/>
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0000010"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>smiles</rdfs:label>
        <skos:definition>A specification in form of a line notation for describing the structure of chemical species using short ASCII strings. Double bond stereochemistry \ indicators may need to be escaped in the string in formats where the backslash is an escape character.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ofbo#OFBO_0009101 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ofbo#OFBO_0009101">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/smiles"/>
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0000011"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has core SMILES</rdfs:label>
        <skos:definition xml:lang="en">Relates a molecular entity to a SMILES string representing its core structural scaffold.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ofbo#OFBO_0009102 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ofbo#OFBO_0009102">
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0008000"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has level of theory</rdfs:label>
        <skos:definition xml:lang="en">Relates a computational process to the reported level of theory, such as B3LYP, PBE0-D3, or HF-3c.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ofbo#OFBO_0009202 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ofbo#OFBO_0009202">
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0001104"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Examples include SHE, NHE, Ag/AgCl, saturated calomel electrode, and ferrocene/ferrocenium.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">has potential reference</rdfs:label>
        <skos:definition xml:lang="en">Relates an electrochemical potential quantity to the reference system against which the potential is reported.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ofbo#OFBO_0009205 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ofbo#OFBO_0009205">
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0007120"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">has electron transfer number</rdfs:label>
        <skos:definition xml:lang="en">Relates an electrochemical reaction to the positive integer number of electrons transferred in that reaction.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- 
