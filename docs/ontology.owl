    <!-- https://w3id.org/ofbo#canonicalUnit -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/ofbo#canonicalUnit">
        <rdfs:label xml:lang="en">canonical unit</rdfs:label>
        <skos:definition xml:lang="en">Relates an OFBO property class to the QUDT unit used as the canonical unit for numerical comparison and cross-study querying.</skos:definition>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/ofbo#relevance -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/ofbo#relevance">
        <rdfs:label xml:lang="en">relevance</rdfs:label>
        <skos:definition>The annotation property relevance links an entity, property, method, or measurement to a textual explanation of its significance or importance in a specific context.

It is used to provide contextual justification, for example, explaining why a property or method is important for (organic) redox flow batteries (RFBs) or other application domains.</skos:definition>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/ofbo#rfbLiterature -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/ofbo#rfbLiterature">
        <rdfs:label xml:lang="en">RFB literature</rdfs:label>
        <skos:definition>The annotation property rfbLiterature links a property, method, or entity to bibliographic references (e.g., DOI) of papers relevant to organic redox flow batteries (ORFBs).

It is used to document sources where the property, descriptor, or method is discussed or demonstrated in the context of ORFBs, allowing users to trace evidence and supporting literature for a given feature.</skos:definition>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    </owl:AnnotationProperty>
    


