     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="http://schema.org/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="https://w3id.org/ofbo">
        <owl:versionIRI rdf:resource="https://w3id.org/ofbo/1.2.0"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-5399-043X"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-2260-8271"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0008-7608-2192"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-30</terms:created>
        <terms:creator rdf:resource="https://orcid.org/0000-0001-9923-9676"/>
        <terms:description xml:lang="en">An ontology for representing molecular, electrochemical, thermodynamic, computational, and provenance information relevant to organic flow-battery electrolyte research.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-30</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:publisher rdf:resource="https://www.scai.fraunhofer.de/"/>
        <terms:source rdf:resource="https://github.com/rfb-predictor/OFBO"/>
        <terms:title xml:lang="en">Organic Flow Battery Ontology</terms:title>
        <vann:preferredNamespacePrefix>ofbo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/ofbo#</vann:preferredNamespaceUri>
        <schema:funding rdf:resource="https://www.rfb-predictor.eu/"/>
        <owl:versionInfo>1.2.0</owl:versionInfo>
        <mod:status xml:lang="en">active</mod:status>
    </owl:Ontology>
    


