    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000010 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000010">
        <owl:disjointWith rdf:resource="https://w3id.org/ofbo#OFBO_0000020"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ofbo#OFBO_0000030"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ofbo#OFBO_0000040"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">chemical entity</rdfs:label>
        <skos:definition xml:lang="en">A chemical entity is any distinct chemical species or material unit that can be described in terms of its identity, properties, state, and participation in chemical systems. It encompasses molecules, ions, radicals, functional groups, or more complex substances, and serves as the fundamental unit for assigning properties, states, and roles within chemical systems.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000011 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000011">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000010"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">molecular entity</rdfs:label>
        <skos:definition xml:lang="en">A molecular entity is any constitutionally or isotopically distinct atom, molecule, ion, radical, or complex, considered as a discrete chemical unit.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23367"/>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000012 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000012">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000011"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">molecule</rdfs:label>
        <skos:definition xml:lang="en">A molecule is a chemically bonded assembly of two or more atoms that behaves as a discrete chemical unit. It has a defined composition, structure, and connectivity, and can exist in various physical and electronic states, including specific geometries, charge states, and spin multiplicities.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25367"/>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000013 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000013">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000010"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">group</rdfs:label>
        <skos:definition xml:lang="en">A group is a recurring substructure or arrangement of atoms within a molecular entity (such as a functional group) that confers characteristic chemical behavior, independent of the rest of the molecular structure in which it occurs.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24433"/>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000014 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000014">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000010"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">chemical system</rdfs:label>
        <skos:definition xml:lang="en">A chemical system is a chemical entity consisting of one or more chemical entities considered together in a defined composition, environment, or experimental context. A chemical system may include solvents, solutes, electrolytes, active materials, additives, ions, and other chemical constituents.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000020 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000020">
        <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/PMD_0020265"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000011"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ofbo#OFBO_0000010"/>
                            <rdf:Description rdf:about="https://w3id.org/ofbo#OFBO_0000031"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ofbo#OFBO_0000030"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ofbo#OFBO_0000040"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">property</rdfs:label>
        <skos:definition xml:lang="en">A property is a measurable or computable characteristic of a chemical entity or physico-chemical process. It may describe structure, composition, reactivity, interactions, spectroscopic behavior, stability, transport behavior, bulk-phase behavior, or a characteristic of a reaction or transformation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000021 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000021">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000020"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">chemical property</rdfs:label>
        <skos:definition xml:lang="en">A chemical property is a property that describes the chemical behavior of an entity, such as its reactivity, electronic structure, acid–base character, or redox behavior, as opposed to its physical or bulk-phase behavior.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/pmd/co/PMD_0020259"/>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000022 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000022">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000020"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">thermodynamic property</rdfs:label>
        <skos:definition xml:lang="en">A thermodynamic property describes the energetic and entropic state of a molecule or system, capturing how energy, heat, and entropy influence chemical processes and stability.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
        <relevance>These properties determine reaction spontaneity, stability, solvation, and degradation tendencies of electrolyte components. They are essential for predicting thermodynamic favorability, reaction equilibria, and molecular behavior under different temperature and pressure conditions.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000023 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000023">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000020"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">fluid mechanics property</rdfs:label>
        <skos:definition xml:lang="en">A fluid dynamics property describes the collective physical behavior of molecules and ions in condensed, flowing phases, including their motion, flow resistance, and packing. It reflects how microscopic interactions translate into macroscopic observable bulk-phase behavior.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/pmd/co/PMD_0020316"/>
        <relevance>These properties determine ionic mobility, conductivity, viscosity, density, and overall performance of electrolytes in electrochemical devices. They are critical for understanding fluid behavior under operating conditions in flow battery systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000024 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000024">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000020"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">characterization property</rdfs:label>
        <skos:definition xml:lang="en">A characterization property describes an observable signature of a chemical entity obtained through spectroscopic or analytical techniques, used to confirm its identity, structure, or electronic environment.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/pmd/co/PMD_0020255"/>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000030 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000030">
        <owl:disjointWith rdf:resource="https://w3id.org/ofbo#OFBO_0000040"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">process</rdfs:label>
        <skos:definition xml:lang="en">A process is an occurrence that unfolds over time, involving changes in the properties, composition, or configuration of one or more chemical entities.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000031 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000031">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000030"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">physico-chemical process</rdfs:label>
        <skos:definition xml:lang="en">A physico-chemical process is a process involving physical or chemical change among chemical entities, including interactions, reactions, and transformations of molecular structure or state.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/REX_0000001"/>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000032 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000032">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000030"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">planned process</rdfs:label>
        <skos:definition xml:lang="en">A planned process is a process that realizes an intentional plan or protocol, such as a computational calculation or a laboratory experiment, carried out to obtain data about a chemical entity or property.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000033 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000033">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">process specification</rdfs:label>
        <skos:definition xml:lang="en">A process specification is an information entity that specifies a configured, controlled, or selected aspect of a planned process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000034 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000034">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000033"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">cyclic voltammetry specification</rdfs:label>
        <skos:definition xml:lang="en">A process specification that specifies an aspect of a cyclic voltammetry process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000035 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000035">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000033"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">implicit solvation model</rdfs:label>
        <skos:definition xml:lang="en">A process specification describing a computational model that represents solvent effects as a continuous dielectric medium rather than as explicit solvent molecules. Examples include PCM, CPCM, COSMO, SMD, and SM8.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000040 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000040">
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">role</rdfs:label>
        <skos:definition xml:lang="en">A role is a function or part played by a chemical entity within a specific context, such as a device, reaction, or system, that is not an intrinsic feature of the entity but depends on how it is used.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0000041 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0000041">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ofbo#OFBO_0000010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">chemical role</rdfs:label>
        <skos:definition xml:lang="en">A chemical role is a role realized by a chemical entity in virtue of its participation in a chemical system, such as acting as a solvent, electrolyte, or active material.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51086"/>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001000 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001000">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000021"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">acid base property</rdfs:label>
        <skos:definition xml:lang="en">An acid–base property describes the ability of a molecule or solvent to donate or accept protons or electron density, characterizing its behavior as a Brønsted or Lewis acid or base.</skos:definition>
        <relevance>Acid–base properties govern proton transfer, ion coordination, and solvation behavior in electrolytes. They influence salt dissociation, ion pairing, interfacial reactions, and chemical stability of electrolyte components.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001010 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001010">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001000"/>
        <rdfs:comment>GB is defined as:

GB = −ΔG° (protonation)

It is closely related to proton affinity (PA):

PA = −ΔH° (protonation)

and

GB ≈ PA − TΔS°

Typical values for small organic molecules range from approximately 600 to 950 kJ mol⁻¹.
For example, water has a gas-phase basicity of about 660 kJ mol⁻¹, while amines typically range from 800 to 900 kJ mol⁻¹.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">basicity</rdfs:label>
        <skos:definition xml:lang="en">Gas-phase basicity (GB) is the negative standard Gibbs free energy change for the protonation of a neutral molecule B in the gas phase:

B (g) + H⁺ (g) → BH⁺ (g)

It quantifies the intrinsic tendency of a molecule to accept a proton in the absence of solvent effects.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ-PER-MOL"/>
        <relevance>Gas-phase basicity provides an intrinsic measure of proton affinity that is independent of solvent effects. In organic redox flow batteries, lower gas-phase basicity can correlate with reduced susceptibility to protonation reactions that may trigger decomposition or alter redox activity in electrolyte environments.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001011 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001011">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001000"/>
        <rdfs:comment>PA = -\Delta H^{\circ}_{\text{protonation}}

Proton affinity is typically reported in kJ mol⁻¹ and represents the enthalpic component of proton binding.

It is closely related to gas-phase basicity (GB), which includes entropic contributions:

GB = −ΔG° of protonation

and therefore

GB ≈ PA − TΔS°

Typical proton affinity values for small molecules range from roughly 600 to 1000 kJ mol⁻¹.
For example:

water ≈ 697 kJ mol⁻¹

ammonia ≈ 854 kJ mol⁻¹

many amines ≈ 900–1000 kJ mol⁻¹</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">proton affinity</rdfs:label>
        <skos:definition xml:lang="en">Proton affinity (PA) is the negative of the standard enthalpy change for the protonation of a neutral molecule in the gas phase:

B (g) + H⁺ (g) → BH⁺ (g)

It quantifies the intrinsic tendency of a molecule to bind a proton in the absence of solvent effects.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ-PER-MOL"/>
        <relevance>Proton affinity provides an intrinsic measure of a molecule&apos;s ability to bind protons without solvent effects. For organic redox flow battery molecules, this property is useful for understanding protonation tendencies and the stability of protonated intermediates. Proton affinity can therefore help rationalize proton-coupled electron transfer reactions and complement solution-phase descriptors such as pKa when evaluating redox-active molecules.</relevance>
        <rfbLiterature>https://doi.org/10.1038/srep39101</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001012 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001012">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001000"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">solvent acidity basicity</rdfs:label>
        <skos:definition xml:lang="en">A solvent acidity/basicity property describes the ability of a solvent to donate or accept electrons or protons. It captures how the solvent interacts with solutes, influencing solvation, hydrogen bonding, and reaction energetics.</skos:definition>
        <relevance>These properties determine how solvents stabilize ions and molecules in electrolyte solutions. They influence solubility, charge distribution, and reactivity, and are critical for predicting solvent effects on chemical and electrochemical behavior.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001013 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001013">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001012"/>
        <rdfs:comment>The acceptor number quantifies the ability of a solvent to accept electron density from a Lewis base. It is determined relative to a reference scale in which hexane is assigned an acceptor number of zero.

Higher AN values indicate stronger Lewis acidity of the solvent and greater ability to stabilize anions or electron-rich species.

Typical examples include:
hexane ≈ 0
acetonitrile ≈ 19
water ≈ 54</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">acceptor number</rdfs:label>
        <skos:definition xml:lang="en">The acceptor number (AN) is an empirical measure of the Lewis acidity of a solvent. It is defined from the shift in the 31P NMR chemical shift of a standard probe molecule, typically triethylphosphine oxide (TEPO), when dissolved in the solvent.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>The acceptor number describes how strongly a solvent can interact with electron-rich species. In organic redox flow batteries, this property influences the stabilization of reduced redox-active molecules, anions, and intermediate species formed during electrochemical reactions. As a result, the acceptor number can affect electrolyte stability, reaction mechanisms, and the electrochemical behavior of organic redox couples.</relevance>
        <rfbLiterature>https://doi.org/10.1016/j.joule.2018.05.014</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001014 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001014">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001012"/>
        <rdfs:comment>Donor number represents the ability of a solvent to donate electron density to a Lewis acid. It corresponds to the enthalpy change of the reaction:

solvent + SbCl5 → solvent–SbCl5 adduct

DN = −ΔH° (adduct formation)

The donor number is typically expressed in kcal/mol. Higher donor numbers indicate stronger electron-pair donating ability and stronger coordination to cations.

Typical examples include:
water ≈ 18
acetonitrile ≈ 14
tetrahydrofuran (THF) ≈ 20
dimethyl sulfoxide (DMSO) ≈ 30</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">donor number</rdfs:label>
        <skos:definition xml:lang="en">The donor number (DN) is a quantitative measure of the Lewis basicity of a solvent. It is defined as the negative enthalpy of formation of the adduct between the solvent and a standard Lewis acid, typically antimony pentachloride (SbCl5), measured in a non-coordinating solvent.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>In organic redox flow battery electrolytes, the donor number influences the ability of solvent molecules to coordinate to cations such as supporting electrolyte ions or charged redox-active species. Solvents with higher donor numbers tend to stabilize cations more strongly, affecting ion pairing, solvation structure, and the redox potentials of dissolved organic molecules.</relevance>
        <rfbLiterature>https://doi.org/10.1016/j.joule.2018.05.014</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001015 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001015">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001000"/>
        <rdfs:comment>pK_a = -\log_{10}(K_a)

where

Ka = [A⁻][H⁺] / [HA]

Lower pKa values indicate stronger acids, while higher pKa values correspond to weaker acids.

Typical ranges in aqueous solution:

strong acids: pKa &lt; 0

carboxylic acids: pKa ≈ 3–5

phenols: pKa ≈ 9–11

alcohols: pKa ≈ 15–18

The pKa value depends on the solvent environment, temperature, and molecular structure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">pKa</rdfs:label>
        <skos:definition xml:lang="en">The pKa of a molecule is the negative base-10 logarithm of the acid dissociation constant (Ka) for the equilibrium between a protonated species and its conjugate base in solution:

HA ⇌ A⁻ + H⁺

It quantifies the tendency of a molecule to donate a proton in a given solvent, typically water.</skos:definition>
        <skos:exactMatch rdf:resource="http://www.bioassayontology.org/bao#BAO_0002131"/>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>pKa values determine the protonation state of redox-active molecules in electrolyte solutions and therefore influence their redox chemistry. In systems where electron transfer is coupled to proton transfer (proton-coupled electron transfer, PCET), pKa values of the oxidized and reduced species control the pH dependence of the redox potential. This relationship allows estimation of redox potentials at different pH values using thermodynamic cycles and the Nernst equation. Consequently, pKa is an important descriptor for predicting electrochemical stability, redox potential shifts, and reaction pathways in organic redox flow battery electrolytes.</relevance>
        <rfbLiterature>https://doi.org/10.1038/srep39101</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001016 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001016">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001000"/>
        <rdfs:comment xml:lang="en">pH is defined as:

pH = −log₁₀(a_H⁺)

where a_H⁺ is the activity of hydrogen ions in a solution.

Lower pH values correspond to more acidic conditions, whereas higher pH values correspond to more basic conditions. pH depends on the composition, temperature, ionic strength, and solvent of the electrolyte system.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">pH</rdfs:label>
        <skos:definition xml:lang="en">pH is the negative base-10 logarithm of the activity of hydrogen ions in a solution. It is a measure of the acidity or basicity of an electrolyte system under specified conditions.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/PH"/>
        <relevance xml:lang="en">pH affects the protonation state, solubility, redox potential, chemical stability, and degradation pathways of organic redox-active molecules. It is particularly important for proton-coupled electron-transfer reactions, in which redox potentials can vary with pH according to the Nernst equation.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001100 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001100">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000021"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electrochemical property</rdfs:label>
        <skos:definition xml:lang="en">An electrochemical property describes how a molecule, ion, or material behaves in an electrochemical environment, including its tendency to undergo oxidation or reduction and its response to applied electrical potentials.</skos:definition>
        <relevance>Electrochemical properties determine the operational stability, voltage window, and redox activity of electrolyte components. They are essential for predicting electrolyte compatibility with electrodes, resistance to oxidative or reductive degradation, and overall electrochemical performance.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001101 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001101">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001100"/>
        <rdfs:comment>Electrochemical window is typically measured in volts versus a reference electrode and depends on both the oxidation potential of the solvent (upper limit) and the reduction potential (lower limit).

Typical ranges for common solvents:

water: 1.23 V

acetonitrile: ~5.5 V

dimethyl sulfoxide (DMSO): ~4.5 V

A wider electrochemical window allows higher cell voltages and more energetic storage without solvent degradation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electrochemical window</rdfs:label>
        <skos:definition xml:lang="en">The electrochemical window of a solvent or electrolyte is the potential range over which it is electrochemically stable, meaning no significant oxidation or reduction of the solvent occurs. It defines the limits within which redox-active species can operate without solvent decomposition.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <relevance>In organic redox flow batteries, the electrochemical window determines the maximum and minimum voltages that can be safely applied. It constrains the choice of redox-active molecules and solvents and affects energy density, stability, and cycle life. Molecules with redox potentials outside the electrochemical window of the solvent may undergo unwanted side reactions, leading to electrolyte decomposition and reduced battery performance.</relevance>
        <rfbLiterature>https://doi.org/10.1039/D5RA00296F</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001102 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001102">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001100"/>
        <rdfs:comment>The peak current ratio is calculated as:
Peak Current Ratio = Ip,a / Ip,c

Ip,a = anodic peak current (oxidation)

Ip,c = cathodic peak current (reduction)

For a reversible, one-electron redox reaction, the peak current ratio is ideally close to 1. Deviations from 1 indicate quasi-reversible or irreversible behavior, adsorption effects, or kinetic limitations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">peak current ratio</rdfs:label>
        <skos:definition xml:lang="en">The peak current ratio is the ratio of the anodic peak current (Ip,a) to the cathodic peak current (Ip,c) observed in a voltammetric experiment, typically cyclic voltammetry. It is a measure of the symmetry of oxidation and reduction processes for a redox-active species.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>In organic redox flow batteries, the peak current ratio is used to assess the reversibility of redox-active molecules. Molecules with peak current ratios near unity indicate fast electron transfer and reversible redox cycling, which are desirable for high-efficiency battery operation. Deviations may signal slow kinetics, chemical instability, or side reactions in the electrolyte.</relevance>
        <rfbLiterature>https://doi.org/10.1038/srep39101</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001103 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001103">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001100"/>
        <rdfs:comment>ΔEp = Ep,a − Ep,c

Ep,a = anodic peak potential (oxidation)

Ep,c = cathodic peak potential (reduction)

For a reversible, one-electron redox process, ΔEp is ideally 59 mV at 25°C. Larger ΔEp values indicate quasi-reversible or irreversible behavior, slow electron transfer kinetics, or coupled chemical reactions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">peak potential gap</rdfs:label>
        <skos:definition xml:lang="en">The peak potential gap, ΔEp, is the difference between the anodic peak potential (Ep,a) and the cathodic peak potential (Ep,c) in a voltammetric experiment, typically cyclic voltammetry. It reflects the separation between oxidation and reduction peaks of a redox-active species.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/MilliV"/>
        <relevance>In organic redox flow batteries, the peak potential gap provides insight into the kinetic reversibility of redox-active molecules. Small ΔEp values indicate fast, reversible electron transfer, which is desirable for efficient cycling. Large ΔEp may suggest slow electron transfer or chemical instability, which can reduce battery efficiency and cycle life.</relevance>
        <rfbLiterature>https://doi.org/10.1002/adfm.202312608</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001104 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001104">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001100"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ofbo#OFBO_0009202"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Redox potential is measured in volts versus a reference electrode and is defined for a reversible electron-transfer reaction.

For a simple one-electron reversible redox reaction:

Oxidized + e⁻ ⇌ Reduced

The Nernst equation relates the redox potential to concentrations:

E = E° + (RT/nF) * ln([Oxidized]/[Reduced])

E° = standard redox potential

n = number of electrons transferred

R = gas constant

T = temperature in Kelvin

F = Faraday constant

Redox potentials are influenced by solvent, pH, supporting electrolytes, and molecular environment. In proton-coupled electron-transfer reactions, pKa values of the species determine the pH-dependent shift of the redox potential.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">redox potential</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/FIX_0000278"/>
        <skos:definition xml:lang="en">The redox potential (standard or formal, E°) of a molecule is the equilibrium potential at which a reversible electrochemical reaction occurs between its oxidized and reduced forms:

Oxidized ⇌ Reduced + e⁻

It quantifies the intrinsic tendency of a molecule to gain or lose electrons under standard conditions (typically 25°C, 1 M concentrations, pH 0 or reference pH).</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <relevance>In organic redox flow batteries, the redox potential determines the voltage at which a molecule can be oxidized or reduced. Proper alignment of redox potentials for the oxidized/reduced species ensures high energy density, electrochemical reversibility, and stable cycling. Accurate redox potentials are essential for selecting compatible redox-active molecules and predicting their performance under varying pH and electrolyte conditions.</relevance>
        <rfbLiterature>https://doi.org/10.1038/srep39101</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001200 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001200">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000021"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electronic structure</rdfs:label>
        <skos:definition xml:lang="en">Electronic structure properties describe the distribution, energies, and interactions of electrons in a molecule, ion, or solid as determined by its quantum-mechanical electronic structure.</skos:definition>
        <skos:exactMatch rdf:resource="http://semanticscience.org/resource/SIO_001099"/>
        <relevance>Electronic structure properties govern chemical reactivity, redox behavior, stability, and intermolecular interactions of electrolyte components. They provide the fundamental link between molecular structure and observable electrochemical, spectroscopic, and thermodynamic properties, making them central to the rational design and screening of electrolyte materials.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001210 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001210">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">charge property</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000131"/>
        <skos:definition xml:lang="en">Charge properties describe the magnitude, distribution, and transfer of electronic charge within and between molecular or ionic species.</skos:definition>
        <relevance>Charge properties control electrostatic interactions, ion pairing, solvation strength, and charge transport in electrolyte systems. They are critical for understanding ion mobility, dielectric response, interfacial behavior, and the stability of charged species in solution and under applied electric fields.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001211 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001211">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001210"/>
        <rdfs:comment>The charge delocalization index is typically calculated using electronic structure methods (e.g., DFT) by analyzing the electron density or population analysis (Mulliken, Löwdin, or natural population analysis).

Higher values indicate greater delocalization of charge, which can stabilize charged intermediates and lower the reorganization energy during electron transfer.

Delocalization indices can be reported globally (whole molecule) or locally (specific functional group or redox-active site).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">charge delocalization index</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000094"/>
        <skos:definition xml:lang="en">The charge delocalization index is a quantitative measure of the extent to which electronic charge is spread over a molecule or a part of a molecule, rather than localized on a single atom or bond. It reflects the distribution of electron density in the oxidized or reduced state of a molecule.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>In organic redox flow batteries, charge delocalization strongly influences the stability of oxidized and reduced species. Molecules with high charge delocalization are less prone to decomposition and side reactions because the charge is spread over multiple atoms, reducing local reactivity. This also typically leads to lower reorganization energies and faster electron-transfer kinetics, improving battery efficiency and cycle life.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001212 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001212">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001210"/>
        <rdfs:comment>Partial charges are typically computed using quantum chemical methods, such as:

Mulliken population analysis

Löwdin population analysis

Natural Population Analysis (NPA)

Electrostatic potential fitting (RESP, CHELPG)

These charges can be positive or negative, depending on whether the atom is electron-deficient or electron-rich. Partial atomic charges are not physical observables, but they are widely used to rationalize reactivity, intermolecular interactions, solvation, and electrostatic effects.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">partial atomic charges</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000119"/>
        <skos:definition xml:lang="en">Partial atomic charges describe the distribution of electronic charge over individual atoms in a molecule, representing deviations from the neutral atom&apos;s nominal charge due to bonding and polarization. They are a measure of how electron density is partitioned within the molecule.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>In organic redox flow batteries, partial atomic charges are important for understanding:

Solvent and ion interactions (coordination and solvation)

Redox behavior (which atoms are more likely to undergo oxidation or reduction)

Electrostatic stabilization of charged intermediates

Accurate partial charges help predict ion mobility, protonation states, and reactivity patterns of redox-active molecules in electrolyte solutions, and are often used as descriptors in computational screening of ORFB candidates.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001220 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001220">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electric response</rdfs:label>
        <skos:definition xml:lang="en">Electric response properties describe how a molecule, ion, or material responds to external electric fields, including polarization, induced dipoles, and overall dielectric behavior.</skos:definition>
        <relevance>These properties determine the ability of electrolytes to screen electric fields, stabilize ions, and support charge transport.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001221 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001221">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001220"/>
        <rdfs:comment>Dipole moment μ = Σ_i q_i * r_i, where q_i is the partial charge on atom i and r_i is its position vector relative to the molecular center
Typical range for small organic molecules: 0–10 Debye
Examples: water ~1.85 D, acetonitrile ~3.9 D</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">dipole moment</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/ElectricDipoleMoment"/>
        <skos:definition xml:lang="en">The dipole moment of a molecule is a vector quantity that measures the separation of positive and negative charge centers within the molecule. It reflects the overall polarity of the molecule and its tendency to interact with electric fields or polar solvents.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/Debye"/>
        <relevance>Determines polarity and solvation behavior in electrolytes, affecting solubility, ion interactions, and dielectric properties.</relevance>
        <rfbLiterature>https://doi.org/10.1038/s41597-022-01814-4</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001222 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001222">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001220"/>
        <rdfs:comment>Mathematical notation / calculation:
Using atomic charges: V(r) = Σ (qi / |r − Ri|)
Using electron density: V(r) = ∫ (ρ(r&apos;) / |r − r&apos;|) dr&apos; − Σ (ZA / |r − RA|)
Typical range for small organic molecules: ~ −5 to +5 V (rough order of magnitude; depends on molecule and reference point)
Examples:
Water: negative region near O, positive near H
Benzene: relatively uniform ESP over π-system</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electrostatic potential</rdfs:label>
        <skos:definition xml:lang="en">The electric potential generated by the molecular charge distribution at a point in space. Calculated from electron density or atomic partial charges.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <relevance>Identifies reactive sites for electrophilic and nucleophilic attack; predicts ion interactions, solvation patterns, and hydrogen bonding; used in electrostatic potential mapping to visualize polar regions of molecules or ions.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001223 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001223">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001220"/>
        <rdfs:comment>Polarizability α = induced dipole moment μ_induced / applied electric field E
Typical range for small organic molecules: ~1–20 Å³
Examples: water ~1.5 Å³, benzene ~10 Å³</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">polarizability</rdfs:label>
        <skos:definition xml:lang="en">Polarizability is a tensor that measures the ease with which the electron cloud of a molecule can be distorted by an external electric field. It reflects the molecule&apos;s ability to respond to electric fields and participate in induced dipole interactions.</skos:definition>
        <skos:exactMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000089"/>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/ANGSTROM3"/>
        <relevance>Influences dielectric behavior and intermolecular interactions in electrolytes, affecting solvation and ion mobility.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001230 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001230">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001200"/>
        <rdfs:comment>E = ⟨Ψ|Ĥ_electronic|Ψ⟩, where Ψ is the electronic wavefunction and Ĥ_electronic is the electronic Hamiltonian
Example: for ethylene carbonate, E ~ −382.5 Hartree; for dimethoxyethane, E ~ −154.3 Hartree</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electronic energy</rdfs:label>
        <skos:definition xml:lang="en">Electronic energy is the sum of the energies of all electrons in a molecule obtained from a quantum chemical calculation. It reflects the overall electronic stability of the molecule.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ-PER-MOL"/>
        <relevance>Serves as a fundamental quantity in computational chemistry. It serves as a foundation for relative energies for stability or calculating the redox potential.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001240 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001240">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electrophilicity</rdfs:label>
        <skos:definition xml:lang="en">Electrophilicity describes the tendency of a molecule or a specific site within a molecule to accept electrons. It quantifies how susceptible the system is to nucleophilic attack.</skos:definition>
        <relevance>Electrophilicity determines which molecules or atomic sites are more likely to undergo electron-accepting reactions. This helps predict chemical reactivity, degradation pathways, and interactions of electrolyte components with nucleophiles.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001241 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001241">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001240"/>
        <rdfs:comment>ω = μ² / (2η), where μ = −(IP + EA)/2
Typical range for small organic molecules: ~0.1–5 eV (depends on system)
Examples: water (strong electrophile) has high ω; alkanes (weak electrophiles) have low ω</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">global electrophilicity index</rdfs:label>
        <skos:definition xml:lang="en">The global electrophilicity index (ω) quantifies the ability of a molecule to accept electrons, based on its ionization potential (IP) and electron affinity (EA).
It reflects the overall electrophilic character of a molecule, with higher values indicating stronger electron-acceptor behavior.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/EV"/>
        <relevance>Indicates how strongly a molecule will accept electrons, affecting reactivity and stability in redox-active electrolytes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001242 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001242">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001240"/>
        <rdfs:comment>ω_k = ω × f_k⁺, where ω is the global electrophilicity index and f_k⁺ is the electrophilic Fukui function at atom k
Typical range: 0 (low reactivity) to ~1 (high reactivity) per site (normalized for the molecule) 
Examples: in H2O, oxygen has higher local electrophilicity than hydrogens; in carbonyls, the carbonyl carbon is the most electrophilic site</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">local electrophilicity</rdfs:label>
        <skos:definition xml:lang="en">Local electrophilicity quantifies the site-specific electron-accepting ability of a molecule.
It is derived by weighting the global electrophilicity index (ω) with the electrophilic Fukui function, indicating which atoms are more likely to undergo nucleophilic attack.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>Identifies reactive sites within a molecule, helping predict degradation or reactivity in electrolytes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001250 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001250">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">frontier orbitals</rdfs:label>
        <skos:definition xml:lang="en">Frontier orbital properties describe the energies and characteristics of the highest occupied molecular orbitals (HOMO) and lowest unoccupied molecular orbitals (LUMO). They reflect the frontier electronic states that govern a molecule&apos;s chemical reactivity.</skos:definition>
        <relevance>Frontier orbitals determine the propensity for electron donation or acceptance in chemical reactions, influence redox behavior, and help predict sites of reactivity in electrolyte molecules.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001251 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001251">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001250"/>
        <rdfs:comment>ε_HOMO = energy of the highest occupied molecular orbital
Typical range for small organic electrolyte molecules: −10 to −5 eV
Examples: ethylene carbonate ~−9 eV, dimethoxyethane ~−6 eV</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">HOMO energy</rdfs:label>
        <skos:definition xml:lang="en">HOMO energy is the energy of the highest occupied molecular orbital of a molecule.
It represents the energetic level of the most weakly bound electrons and characterizes the molecule&apos;s ability to donate electrons. Has been observed to correlate with redox potential.</skos:definition>
        <skos:exactMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000291"/>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/EV"/>
        <relevance>Indicates electron-donating ability and oxidative stability of electrolyte components, helping predict their susceptibility to oxidation in electrochemical environments.</relevance>
        <rfbLiterature>https://doi.org/10.1002/anie.202515639</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001252 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001252">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001250"/>
        <rdfs:comment>ΔE_HL = ε_LUMO − ε_HOMO
Typical range for small organic electrolyte molecules: 5 to 10 eV
Examples: ethylene carbonate ~8 eV, dimethoxyethane ~7 eV</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">HOMO–LUMO gap</rdfs:label>
        <skos:definition xml:lang="en">The HOMO–LUMO gap is the energy difference between the lowest unoccupied molecular orbital (LUMO) and the highest occupied molecular orbital (HOMO) of a molecule. It reflects the electronic stability of a molecule and the energy required to promote an electron from the HOMO to the LUMO.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/EV"/>
        <relevance>Provides a measure of chemical stability and reactivity; a larger gap indicates lower reactivity and higher oxidative/reductive stability, while a smaller gap suggests higher reactivity and easier electron transfer. Can also approximate the redox potential.</relevance>
        <rfbLiterature>https://doi.org/10.1002/anie.202515639</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001253 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001253">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001250"/>
        <rdfs:comment>ε_LUMO = energy of the lowest unoccupied molecular orbital
Typical range for small organic electrolyte molecules: −1 to 5 eV
Examples: ethylene carbonate ~1 eV, dimethoxyethane ~3 eV</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">LUMO energy</rdfs:label>
        <skos:definition xml:lang="en">LUMO energy is the energy of the lowest unoccupied molecular orbital of a molecule, representing the lowest-energy orbital available to accept electrons during chemical reactions.</skos:definition>
        <skos:exactMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000292"/>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/EV"/>
        <relevance>Indicates electron-accepting ability and reduction susceptibility of electrolyte components, helping predict which species are more likely to undergo reduction in electrochemical systems.</relevance>
        <rfbLiterature>https://doi.org/10.1002/anie.202515639</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001260 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001260">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">fukui function</rdfs:label>
        <skos:definition xml:lang="en">Fukui function properties describe the change in electron density at a specific site or overall in a molecule upon addition or removal of electrons. They indicate which atoms or regions are most likely to participate in nucleophilic or electrophilic reactions.</skos:definition>
        <relevance>Fukui functions help identify reactive sites in molecules, predict chemical reactivity patterns, and assess degradation or reaction pathways in electrolyte systems.</relevance>
        <rfbLiterature>https://doi.org/10.1038/s41467-025-59962-1</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001261 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001261">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001260"/>
        <rdfs:comment>Δf_k = f_k⁺ − f_k⁻, where f_k⁺ is the electrophilic Fukui function and f_k⁻ is the nucleophilic Fukui function at atom k
Typical range: −1 to 1 per site, where negative values indicate electrophilic susceptibility and positive values indicate nucleophilic susceptibility
Examples: in H2O, oxygen has a negative dual descriptor (more electrophilic), while hydrogens have positive values (more nucleophilic); in carbonyls, the carbonyl carbon is negative and the oxygen is positive</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">condensed dual descriptor</rdfs:label>
        <skos:definition xml:lang="en">The condensed dual descriptor combines the electrophilic and nucleophilic Fukui functions to indicate whether a specific atom in a molecule is more prone to electrophilic or nucleophilic attack. Positive values suggest preference for nucleophilic attack, while negative values indicate preference for electrophilic attack.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>Directly identifies which atoms in a molecule are more likely to undergo electrophilic or nucleophilic attack. In electrolytes, this helps predict reactive sites for degradation, coordination with cations or anions, and other chemical transformations.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001262 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001262">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001260"/>
        <rdfs:comment>f_k⁺ = ρ_N+1(k) − ρ_N(k), where ρ_N(k) is the electron density at atom k in the neutral molecule and ρ_N+1(k) is the density after adding one electron
Typical range: 0 (low susceptibility) to ~1 (high susceptibility) per site
Examples: in H2O, oxygen has a higher electrophilic Fukui function than hydrogens; in carbonyls, the carbonyl carbon is the most electrophilic site</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electrophilic fukui function</rdfs:label>
        <skos:definition xml:lang="en">The electrophilic Fukui function quantifies the susceptibility of specific atoms in a molecule to undergo nucleophilic attack. It indicates which sites are more likely to accept electrons based on changes in electron density upon adding an electron.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>Helps identify reactive sites in molecules, supporting predictions of nucleophilic attack and chemical reactivity in electrolyte systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001263 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001263">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001260"/>
        <rdfs:comment>f_k⁻ = ρ_N(k) − ρ_N−1(k), where ρ_N(k) is the electron density at atom k in the neutral molecule and ρ_N−1(k) is the density after removing one electron
Typical range: 0 (low susceptibility) to ~1 (high susceptibility) per site
Examples: in H2O, hydrogens have higher nucleophilic Fukui function than oxygen; in carbonyls, the oxygen atom is the most nucleophilic site</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">nucleophilic fukui function</rdfs:label>
        <skos:definition xml:lang="en">The nucleophilic Fukui function quantifies the susceptibility of specific atoms in a molecule to undergo electrophilic attack. It indicates which sites are more likely to donate electrons based on changes in electron density upon removing an electron.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>Helps identify reactive sites in molecules, supporting predictions of electrophilic attack and chemical reactivity in electrolyte systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001270 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001270">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">ionization property</rdfs:label>
        <skos:definition xml:lang="en">Ionization properties describe the tendency of a molecule or atom to lose or gain electrons, reflecting its reactivity and stability in redox or electrochemical processes.</skos:definition>
        <relevance>These properties determine how easily a molecule can be oxidized or reduced, influencing electrochemical stability, redox behavior, and degradation pathways of electrolyte components.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001271 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001271">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001270"/>
        <rdfs:comment>η = (IP − EA)/2, where IP is the ionization potential and EA is the electron affinity
Typical range for small organic electrolyte molecules: 2 to 6 eV
Examples: ethylene carbonate ~4 eV, dimethoxyethane ~3 eV</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">chemical hardness</rdfs:label>
        <skos:definition xml:lang="en">Chemical hardness measures the resistance of a molecule to change its electron density, reflecting its stability against deformation of the electron cloud or transfer of electrons.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.enanomapper.org/onto/ENM_8000099"/>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/EV"/>
        <relevance>Indicates molecular stability and resistance to electron transfer; harder molecules are less reactive, while softer molecules are more prone to chemical reactions in electrolytes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001272 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001272">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001270"/>
        <rdfs:comment>EA = E(neutral) − E(anion), where E(neutral) is the energy of the neutral molecule and E(anion) is the energy of the molecule after gaining one electron
Typical range for small organic electrolyte molecules: 0 to 3 eV
Examples: ethylene carbonate ~1.2 eV, dimethoxyethane ~0.5 eV</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electron affinity</rdfs:label>
        <skos:definition xml:lang="en">Electron affinity is the energy change associated with adding an electron to a neutral molecule, representing the molecule&apos;s tendency to accept electrons.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/EV"/>
        <relevance>Indicates the molecule&apos;s ability to accept electrons, helping predict reduction behavior and stability of electrolyte components under electrochemical conditions.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001273 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001273">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001270"/>
        <rdfs:comment>IP = E(cation) − E(neutral), where E(neutral) is the energy of the neutral molecule and E(cation) is the energy after removing one electron
Typical range for small organic electrolyte molecules: 7 to 12 eV
Examples: ethylene carbonate ~10 eV, dimethoxyethane ~8 eV</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">ionization potential</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000191"/>
        <skos:definition xml:lang="en">Ionization potential is the energy required to remove an electron from a neutral molecule, representing the molecule&apos;s tendency to lose electrons.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/EV"/>
        <relevance>Indicates the molecule&apos;s susceptibility to oxidation, helping predict oxidative stability of electrolyte components in electrochemical systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001300 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001300">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000021"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">structural property</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000085"/>
        <skos:definition xml:lang="en">A structural property is a property of a chemical entity that is derived from its three-dimensional geometry or spatial arrangement and requires computation or measurement to obtain. This includes characteristics such as molecular volume, surface area, or molar mass.</skos:definition>
        <relevance>Structural properties influence how molecules or ions interact with solvents, other ions, and electrodes, affecting solubility, diffusion, and transport properties.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001301 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001301">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001300"/>
        <rdfs:comment>Calculation: Ventity = Σ (4/3 π ri³) − overlap corrections, where ri is the van der Waals radius of atom i; optionally, solvent-accessible volume can be computed using a probe sphere over the surface.
Typical range for small organic molecules: ~25–100 Å³
Examples: methane ~28 Å³, ethanol ~48 Å³, benzene ~88 Å³, quinone derivative ~95 Å³</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">entity volume</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000222"/>
        <skos:definition xml:lang="en">The three-dimensional space occupied by a chemical entity, such as a molecule, ion, or radical, derived from its atomic coordinates. Entity volume depends on the van der Waals radii of atoms and the overall geometry of the species. It is a calculated structural property, not a fixed molecular constant, and can change with conformation or solvation environment.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/ANGSTROM3"/>
        <relevance>Measures the effective size of molecules or ions, influencing solubility, ion transport, packing, and stability in organic electrolytes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001302 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001302">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001300"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">entity mass</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000083"/>
        <skos:definition xml:lang="en">The molar mass of a chemical entity is the mass of one mole of that entity, calculated as the sum of the atomic masses of its constituent atoms, typically expressed in grams per mole (g/mol).</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-MOL"/>
        <relevance>Affects diffusion rates, solubility, and energy density calculations for redox-active molecules used in organic redox flow batteries.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001303 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001303">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001300"/>
        <rdfs:comment>S = area enclosed by the van der Waals surface of the entity
Typical range for small organic molecules: ~50–150 Å²
Examples: Methane: S ~50 Å², Quinone derivative: S ~100 Å²</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">surface area</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000247"/>
        <skos:definition xml:lang="en">The total area of a chemical entity&apos;s surface calculated from its three-dimensional geometry. This is a calculated structural property, not a fixed molecular constant.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/NanoM2"/>
        <relevance>Determines solvent interactions and molecular packing; influences diffusion, solubility, and electrochemical accessibility in organic electrolytes.</relevance>
        <rfbLiterature>https://doi.org/10.1038/s41597-022-01814-4</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001400 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001400">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000021"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">kinetic property</rdfs:label>
        <skos:closeMatch rdf:resource="http://biomodels.net/SBO/SBO_0000009"/>
        <skos:definition xml:lang="en">A kinetic property describes the rate at which a chemical or electrochemical process proceeds, as opposed to its thermodynamic favorability.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001401 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001401">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001400"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">rate constant</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/PROCO_0000060"/>
        <skos:definition xml:lang="en">The rate constant is a kinetic parameter that quantifies the speed of a chemical reaction under given conditions. It appears in the rate law, which relates the reaction rate to the concentrations of reactants.</skos:definition>
        <relevance>For a general reaction:

A + B → Products

the rate law can be written as:

rate = k [A]^m [B]^n

where:

k = rate constant

m, n = reaction orders with respect to A and B

The rate constant depends on temperature, solvent, and the presence of catalysts. It is typically reported in units that depend on the overall order of the reaction (s⁻¹ for first order, M⁻¹ s⁻¹ for second order, etc.).

In organic redox flow batteries, the rate constant determines how quickly a redox-active species undergoes a chemical reaction, including electron-transfer reactions, protonation/deprotonation, or decomposition. Faster reaction rates are essential for achieving high current densities and efficient charge/discharge cycles.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001402 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001402">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001401"/>
        <rdfs:comment>For a simple one-electron redox reaction at an electrode:

Oxidized + e⁻ ⇌ Reduced

The heterogeneous rate constant, k₀, is defined at standard conditions and can be measured by cyclic voltammetry or electrochemical impedance spectroscopy. It has units of cm/s.

The magnitude of k₀ reflects the speed of electron transfer between the redox species and the electrode surface. Larger k₀ values indicate faster electron transfer and more reversible behavior.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">heterogeneous rate constant</rdfs:label>
        <skos:definition xml:lang="en">The heterogeneous rate constant is the rate constant for an electron transfer reaction occurring at an electrode interface. It quantifies the intrinsic electron-transfer kinetics of a redox couple under reversible or quasi-reversible conditions.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/CentiM-PER-SEC"/>
        <relevance>In organic redox flow batteries, the heterogeneous rate constant is critical for determining charge/discharge kinetics at the electrodes. High k₀ values ensure efficient electron transfer, minimize overpotentials, and reduce energy losses. Low k₀ can lead to quasi-reversible or irreversible electrochemistry, reducing battery power density and efficiency.</relevance>
        <rfbLiterature>https://doi.org/10.1002/adfm.202312608</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001500 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001500">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000021"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">transport property</rdfs:label>
        <skos:definition xml:lang="en">A transport property describes the movement of ions, molecules, or charge carriers through a medium, such as an electrolyte solution or membrane.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001501 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001501">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001500"/>
        <rdfs:comment>D = lim_{t→∞} ⟨|r(t) − r(0)|²⟩ / (6·t) for three-dimensional diffusion, where r(t) is the particle position at time t
Typical range for small organic electrolyte molecules: 0.5 to 3 × 10⁻⁹ m²/s
Examples: Li⁺ in ethylene carbonate ~1 × 10⁻⁹ m²/s; dimethoxyethane ~2 × 10⁻⁹ m²/s</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">diffusion coefficient</rdfs:label>
        <skos:closeMatch rdf:resource="http://biomodels.net/SBO/SBO_0000491"/>
        <skos:definition xml:lang="en">The diffusion coefficient quantifies the rate at which particles (molecules, ions) move through a medium due to random thermal motion. It reflects how quickly species can migrate in a solvent or electrolyte.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/CentiM2-PER-SEC"/>
        <relevance>Determines ion and solvent mobility, affecting transport properties, conductivity, and overall performance of electrolyte systems.</relevance>
        <rfbLiterature>https://doi.org/10.1039/D1TA03655F</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001502 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001502">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001500"/>
        <rdfs:comment>σ = Σ_i z_i²·F²·c_i·D_i / (R·T), where z_i is the ion charge, c_i its concentration, D_i its diffusion coefficient, F is Faraday&apos;s constant, R is the gas constant, and T is temperature
Typical range for liquid organic electrolytes: 1 × 10⁻³ to 1 × 10⁻¹ S/cm
Examples: 1 M LiPF6 in ethylene carbonate/dimethyl carbonate mixture ~1 × 10⁻² S/cm; NaCl in dimethoxyethane ~5 × 10⁻³ S/cm</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">ionic conductivity</rdfs:label>
        <skos:definition xml:lang="en">Ionic conductivity is a measure of an electrolyte&apos;s ability to conduct electric current via the movement of ions. It reflects the mobility and concentration of charge carriers in the solution.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/S-PER-M"/>
        <relevance>Indicates the efficiency of ion transport in electrolytes, directly affecting battery performance, charge/discharge rates, and electrochemical device efficiency.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001503 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001503">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001500"/>
        <rdfs:comment>t⁺ = I_cation / I_total or t⁺ = D_cation / (D_cation + D_anion) for ideal dilute solutions, where D is the diffusion coefficient
Typical range for liquid organic electrolytes: 0.2 to 0.6 for cations
Examples: Li⁺ in 1 M LiPF6 ethylene carbonate/dimethyl carbonate mixture ~0.35; Na⁺ in dimethoxyethane ~0.4</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">transference number</rdfs:label>
        <skos:definition xml:lang="en">The transference number (t⁺ or t⁻) is the fraction of the total ionic current carried by a specific ion (cation or anion) in an electrolyte. It reflects the relative mobility of ions under an applied electric field.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>Indicates which ion dominates charge transport in an electrolyte, affecting polarization, battery efficiency, and performance in electrochemical systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001601 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001601">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000034"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">scan rate specification</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/nfdi4cat/voc4cat_0007213"/>
        <skos:definition xml:lang="en">A cyclic voltammetry specification that specifies the rate at which the applied potential is varied during cyclic voltammetry.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001602 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001602">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000034"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">cycle count specification</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/nfdi4cat/voc4cat_0007228"/>
        <skos:definition xml:lang="en">A cyclic voltammetry specification that specifies the number of potential cycles performed during cyclic voltammetry.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0001603 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0001603">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000034"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">potential window specification</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_c39b2498_783e_48e1_9814_6164bd99823c"/>
        <skos:definition xml:lang="en">A cyclic voltammetry specification that specifies the applied potential range used during cyclic voltammetry.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0002001 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0002001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000022"/>
        <rdfs:comment>BDE = E_radical1 + E_radical2 − E_molecule, where E_molecule is the energy of the intact molecule and E_radical1/2 are the energies of the resulting radicals
Typical range for small organic molecules: 300 to 500 kJ/mol
Examples: C–H bond in dimethoxyethane ~410 kJ/mol; C=O bond in ethylene carbonate ~390 kJ/mol</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">bond dissociation energy</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000210"/>
        <skos:definition xml:lang="en">Bond dissociation energy (BDE) is the energy required to homolytically break a specific chemical bond in a molecule, forming two radicals. It reflects the strength of the bond and the molecule&apos;s resistance to bond cleavage.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ-PER-MOL"/>
        <relevance>Indicates the strength of chemical bonds and susceptibility to homolytic cleavage, helping predict degradation pathways, radical formation, and chemical stability in electrolytes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0002002 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0002002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000022"/>
        <rdfs:comment>H = U + pV, where U is the internal energy, p is the pressure, and V is the volume. Only relative energies have significant meaning.
Typical range for small organic molecules: varies widely depending on size and composition; relative changes (ΔH) for reactions are typically −200 to +200 kJ/mol
Examples: ΔH of ethylene carbonate ring-opening ~−50 kJ/mol; ΔH of dimethoxyethane oxidation ~+30 kJ/mol</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">enthalpy</rdfs:label>
        <skos:definition xml:lang="en">Enthalpy (H) is the total heat content of a system at constant pressure, representing the sum of its internal energy and the energy associated with pressure–volume work. In molecular systems, it is often used to evaluate reaction energetics and thermodynamic stability.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/pmd/co/PMD_0080052"/>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ-PER-MOL"/>
        <relevance>Helps evaluate thermodynamic favorability of reactions, stability of molecules, and heat changes during degradation or interaction processes in electrolyte systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0002003 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0002003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0002002"/>
        <rdfs:comment>ΔH_f = H_compound − Σ H_elements, where H_compound is the enthalpy of the compound and H_elements are the enthalpies of the constituent elements in their standard states
Typical range for small organic molecules: −500 to 0 kJ/mol
Examples: ethylene carbonate ΔH_f ~−350 kJ/mol; dimethoxyethane ΔH_f ~−250 kJ/mol</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">heat of formation</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/CHEMINF_000241"/>
        <skos:definition xml:lang="en">Heat of formation (ΔH_f) is the change in enthalpy when one mole of a compound is formed from its constituent elements in their standard states. It reflects the thermodynamic stability of the compound relative to its elements.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ-PER-MOL"/>
        <relevance>Indicates the inherent thermodynamic stability of molecules, helping predict reactivity, decomposition tendencies, and suitability of compounds as electrolyte components.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0002004 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0002004">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000022"/>
        <rdfs:comment>S = k_B ln Ω, where k_B is the Boltzmann constant and Ω is the number of accessible microstates
Typical range for small organic molecules: 100 to 400 J/mol·K
Examples: ethylene carbonate ~200 J/mol·K; dimethoxyethane ~250 J/mol·K</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">entropy</rdfs:label>
        <skos:definition xml:lang="en">Entropy (S) is a measure of the disorder or randomness in a system. In molecular systems, it reflects the number of accessible microstates and the flexibility or freedom of motion of the molecules.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/pmd/co/PMD_0080050"/>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-MOL-K"/>
        <relevance>Helps evaluate thermodynamic contributions to reactions and stability, including the balance between enthalpic and entropic effects in degradation, solvation, and other processes in electrolytes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0002005 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0002005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000022"/>
        <rdfs:comment>G = H − T·S, where H is enthalpy, T is temperature, and S is entropy. Only relative energies have significant meaning.
Typical range for small organic molecules: −200 to +200 kJ/mol for reaction free energies
Examples: ΔG of ethylene carbonate ring-opening ~−20 kJ/mol; ΔG of dimethoxyethane oxidation ~+10 kJ/mol</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">gibbs free energy</rdfs:label>
        <skos:definition xml:lang="en">Gibbs free energy (G) is a thermodynamic quantity that combines enthalpy and entropy to determine the spontaneity of a process at constant temperature and pressure. It reflects the maximum reversible work a system can perform.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/pmd/co/PMD_0020361"/>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ-PER-MOL"/>
        <relevance>Indicates thermodynamic favorability of reactions and processes, helping predict stability, degradation, and reaction pathways of electrolyte components.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0002006 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0002006">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0002005"/>
        <rdfs:comment>G_a = G_TS − G_reactant, where E_TS is the energy of the transition state and E_reactant is the energy of the initial molecule
Typical range for small organic electrolyte molecules: 50 to 200 kJ/mol, depending on the reaction pathway
Examples: ethylene carbonate decomposition via ring-opening ~120 kJ/mol; dimethoxyethane oxidative degradation ~90 kJ/mol</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">gibbs free energy of activation</rdfs:label>
        <skos:definition xml:lang="en">The gibbs free energy of activation is the minimum free energy required for a molecule to undergo a chemical transformation via a given reaction pathway. It represents the kinetic stability of the molecule under given conditions.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ-PER-MOL"/>
        <relevance>Indicates the kinetic stability of reactant components, helping predict degradation rates, shelf-life, and performance under electrochemical conditions.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0002007 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0002007">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0002005"/>
        <rdfs:comment>ΔG_rxn = G_products − G_reactant, where G_reactant is the Gibbs free energy of the intact molecule and G_products is that of the products
Typical range for small organic electrolyte molecules: −100 to +50 kJ/mol, depending on the reaction
Examples: ethylene carbonate ring-opening degradation ~−20 kJ/mol; dimethoxyethane oxidative degradation ~−10 kJ/mol</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">gibbs free energy of reaction</rdfs:label>
        <skos:definition xml:lang="en">The gibbs free energy of reaction is the change in Gibbs free energy associated with the chemical reaction of a molecule. It reflects the thermodynamic favorability of the reaction process.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ-PER-MOL"/>
        <relevance>Provides insight into whether chemical reactions are thermodynamically favorable.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0002008 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0002008">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000022"/>
        <rdfs:comment>S = log₁₀(c_max), where c_max is the maximum molar concentration of the solute in the solvent
Typical range for small organic molecules in common solvents: −2 to 2 (log₁₀ mol/L)
Examples: LiPF6 in ethylene carbonate ~0.5; NaCl in dimethoxyethane ~−1</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">solubility</rdfs:label>
        <skos:definition xml:lang="en">Solubility is the maximum concentration of a solute that can dissolve in a solvent at a given temperature and pressure. It reflects the thermodynamic favorability of solute–solvent interactions.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/MOL-PER-L"/>
        <relevance>Determines how much electrolyte or salt can dissolve in a solvent, influencing ionic strength, conductivity, and overall electrolyte performance.</relevance>
        <rfbLiterature>https://doi.org/10.1021/acs.chemrev.5c00332</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0002009 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0002009">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000022"/>
        <rdfs:comment>ZPE = (1/2) Σ h·ν_i, where the sum is over all vibrational modes ν_i of the molecule
Typical range for small organic molecules: 50 to 500 kJ/mol, depending on molecular size and bonding
Examples: ethylene carbonate ~200 kJ/mol; dimethoxyethane ~150 kJ/mol</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">zero point energy</rdfs:label>
        <skos:definition xml:lang="en">Zero-point energy (ZPE) is the lowest possible vibrational energy that a molecule possesses, even at absolute zero temperature. It reflects the quantum mechanical motion of atoms in their equilibrium positions.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ-PER-MOL"/>
        <relevance>Contributes to the total electronic and thermodynamic energy of molecules, affecting reaction energies, stability, and accurate modeling of degradation or solvation processes in electrolytes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003000 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003000">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000024"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">spectroscopic property</rdfs:label>
        <skos:definition xml:lang="en">Spectroscopic properties describe how a molecule interacts with electromagnetic radiation or magnetic fields, revealing information about its electronic structure, vibrational modes, and magnetic environment.</skos:definition>
        <relevance>These properties enable experimental and computational characterization of molecular structure, bonding, and electronic states. In electrolytes, they help validate molecular models, monitor degradation, and understand interactions at the atomic and molecular level.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003010 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003010">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003000"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">absorption spectrum</rdfs:label>
        <skos:definition xml:lang="en">An absorption spectrum describes how a molecule or ion absorbs electromagnetic radiation as a function of wavelength or energy. Absorption spectra capture transitions between quantized energy states, providing information about electronic structure, excited states, or vibrational modes.</skos:definition>
        <relevance>These spectra reveal electronic and vibrational properties, predict light absorption behavior of electrolytes, and help validate computational models. They are used to assess photochemical stability, UV–Vis and IR/Raman activity, and the response of electrolyte molecules to electromagnetic fields.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003011 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003011">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003010"/>
        <rdfs:comment>Absorbance A(λ) or A(E) is plotted versus wavelength λ or energy E, where peaks correspond to allowed electronic transitions.
Typical range for small organic molecules: 150–400 nm (UV) and 400–700 nm (visible), depending on the chromophores present
Examples: ethylene carbonate absorbs mainly in the UV around 180–200 nm; conjugated molecules like stilbene show visible absorption ~300–350 nm</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">UV–Vis spectrum</rdfs:label>
        <skos:definition xml:lang="en">The UV–Vis spectrum represents the absorption of ultraviolet and visible light by a molecule as a function of wavelength or energy. It reflects electronic transitions from occupied to unoccupied molecular orbitals, primarily π→π* and n→π* transitions in organic molecules.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/NanoM"/>
        <relevance>Provides information on electronic structure and conjugation, helping predict optical properties, photostability, and potential photo-induced reactions of molecules in electrolytes and other systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003012 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003012">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003010"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">vibrational spectrum</rdfs:label>
        <skos:definition xml:lang="en">A vibrational spectrum describes the quantized vibrational motions of atoms within a molecule, which interact with electromagnetic radiation. It provides information about bond strengths, molecular geometry, and functional groups.</skos:definition>
        <relevance>These properties are critical for identifying molecular structure, detecting functional groups, and monitoring interactions such as hydrogen bonding. In electrolytes, vibrational spectra can reveal solvation effects, molecular dynamics, and degradation pathways.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003013 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003013">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003012"/>
        <rdfs:comment>Absorbance or transmittance is plotted versus wavenumber (cm⁻¹). Typical vibrational frequencies for organic molecules range from 400 to 4000 cm⁻¹.
Examples: C=O stretching in ethylene carbonate ~1800 cm⁻¹; C–H stretching in dimethoxyethane ~2900 cm⁻¹</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">IR spectrum</rdfs:label>
        <skos:definition xml:lang="en">The IR spectrum represents the absorption of infrared light by a molecule as a function of frequency or wavenumber. It reflects vibrational transitions within the molecule, providing information about bond strengths, functional groups, and molecular structure.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/PER-CentiM"/>
        <relevance>Helps experimentally identify functional groups, bonding patterns, and molecular interactions, supporting structural characterization and analysis of electrolytes and organic molecules.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003014 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003014">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003012"/>
        <rdfs:comment>Raman intensity is plotted versus wavenumber shift (cm⁻¹). Typical vibrational frequencies for small organic molecules range from 100 to 3500 cm⁻¹.
Examples: C=O stretching in ethylene carbonate ~1800 cm⁻¹; C–H stretching in dimethoxyethane ~2950 cm⁻¹</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">raman spectrum</rdfs:label>
        <skos:definition xml:lang="en">The Raman spectrum represents inelastic scattering of light by a molecule, where incident photons exchange energy with molecular vibrations. It provides complementary vibrational information to IR spectroscopy, particularly for vibrations involving changes in polarizability.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/PER-CentiM"/>
        <relevance>Provides information on vibrational modes, molecular structure, and interactions. In electrolytes, Raman spectra help probe solvation structures, ion–solvent interactions, and conformational changes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003020 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003020">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003000"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">magnetic resonance spectrum</rdfs:label>
        <skos:definition xml:lang="en">Magnetic resonance properties describe how nuclei or unpaired electrons interact with external magnetic fields. They provide information about local electronic environments, spin distributions, and magnetic interactions in molecules.</skos:definition>
        <relevance>These properties are essential for characterizing molecular structure, bonding, and electron distribution in electrolyte components. They help predict NMR and EPR spectra, monitor molecular dynamics, and validate computational models of chemical environments.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003021 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003021">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003020"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">EPR spectrum</rdfs:label>
        <skos:definition xml:lang="en">The EPR spectrum describes the interaction of unpaired electron spins with an external magnetic field, providing information about electronic structure, spin distribution, and local magnetic environments in paramagnetic species.</skos:definition>
        <relevance>EPR properties help characterize radicals, transition-metal complexes, and other paramagnetic molecules. They are critical for understanding electron localization, magnetic interactions, and reactivity in electrolyte systems containing unpaired electrons.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003022 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003022">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003021"/>
        <rdfs:comment>The hyperfine tensor is a 3×3 matrix: A = [A_xx, A_xy, A_xz; A_yx, A_yy, A_yz; A_zx, A_zy, A_zz], with principal components A_x, A_y, A_z obtained by diagonalization. Typical values for organic radicals: A ~0–10 mT depending on the nucleus.
Examples: methyl radical ^1H A ~2 mT; oxygen-centered radical in carbonate solvents ^17O A ~5 mT</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">hyperfine tensor</rdfs:label>
        <skos:definition xml:lang="en">The hyperfine tensor describes the interaction between an unpaired electron&apos;s magnetic moment and nearby nuclear spins in electron paramagnetic resonance (EPR) spectroscopy. It reflects the distribution of spin density over the molecule and the coupling with specific nuclei.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/MilliT"/>
        <relevance>Provides detailed information on spin distribution and electron–nucleus interactions, helping identify radical localization, bonding environment, and reactivity in electrolyte and redox-active systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003023 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003023">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003021"/>
        <rdfs:comment>The g tensor is a 3×3 matrix: g = [g_xx, g_xy, g_xz; g_yx, g_yy, g_yz; g_zx, g_zy, g_zz], with principal components g_x, g_y, g_z obtained by diagonalization. Typical values for organic radicals: g ~2.002–2.005
Examples: methyl radical g ~2.003, oxygen-centered radical in carbonate solvents g ~2.004</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">g tensor</rdfs:label>
        <skos:definition xml:lang="en">The g tensor describes the interaction between the electronic spin and an external magnetic field in electron paramagnetic resonance (EPR) spectroscopy. It reflects deviations from the free-electron g value due to the molecular electronic environment and spin–orbit coupling.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>Provides insight into the electronic environment of unpaired electrons, spin delocalization, and molecular structure in radicals or paramagnetic species relevant to electrolytes and redox-active molecules.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003024 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003024">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003020"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">NMR spectrum</rdfs:label>
        <skos:definition xml:lang="en">The NMR spectrum describes how atomic nuclei interact with external magnetic fields, providing information about the local electronic environment and molecular structure.</skos:definition>
        <relevance>These properties are essential for determining chemical structure, bonding, and electron distribution in electrolyte molecules. NMR data can validate computational models, probe molecular dynamics, and assess solvent or ion effects on nuclei.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003025 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003025">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003024"/>
        <rdfs:comment>δ = (ν_sample − ν_ref) / ν_ref × 10^6, where ν_sample is the resonance frequency of the nucleus and ν_ref is that of the reference compound
Typical range for ^1H NMR in organic molecules: 0–12 ppm; for ^13C NMR: 0–220 ppm
Examples: ^1H in water ~4.8 ppm, ^1H in ethylene carbonate ~4.3 ppm; ^13C in carbonyl carbon of ethylene carbonate ~155 ppm</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">chemical shift</rdfs:label>
        <skos:definition xml:lang="en">Chemical shift is the resonant frequency of a nucleus relative to a reference in nuclear magnetic resonance (NMR) spectroscopy. It reflects the local electronic environment around the nucleus and how it shields or deshields the applied magnetic field.</skos:definition>
        <skos:exactMatch rdf:resource="http://nmrML.org/nmrCV#NMR:1000223"/>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/PPM"/>
        <relevance>Provides information on the electronic environment and bonding of nuclei, helping elucidate molecular structure, functional groups, and interactions in electrolytes and other chemical systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003026 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003026">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0003024"/>
        <rdfs:comment>σ = [σ_xx, σ_xy, σ_xz; σ_yx, σ_yy, σ_yz; σ_zx, σ_zy, σ_zz], where the tensor components describe the shielding along different spatial directions. Average of the trace elements results in isotropic shielding. The absolute value correlates with the number of electrons.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">shielding tensor</rdfs:label>
        <skos:definition xml:lang="en">The shielding tensor describes the local magnetic shielding experienced by a nucleus due to the surrounding electron density in a molecule. It is used to compute and interpret NMR chemical shifts.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <relevance>Provides a detailed description of the local magnetic environment, allowing prediction and interpretation of NMR chemical shifts, anisotropy, and electronic structure in molecules, including electrolytes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003030 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003030">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001200"/>
        <rdfs:comment>ΔE_exc = E_excited − E_ground, where E_ground is the energy of the electronic ground state and E_excited is the energy of the excited state
Typical range for small organic molecules: 2 to 8 eV
Examples: ethylene carbonate first singlet excitation ~6 eV, dimethoxyethane first singlet excitation ~5 eV</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">excitation energy</rdfs:label>
        <skos:definition xml:lang="en">Excitation energy is the energy required to promote a molecule from its electronic ground state to an excited electronic state. It reflects the energy difference between the occupied and unoccupied molecular orbitals involved in the transition, and is commonly derived from UV–Vis absorption data or excited-state calculations.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/EV"/>
        <relevance>Determines the wavelengths of light a molecule can absorb, influencing optical properties, photostability, and potential photo-induced reactions in electrolytes or other molecular systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0003031 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0003031">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0001200"/>
        <rdfs:comment>ν_i = (1/2π) √(k_i/μ_i), where k_i is the force constant of mode i and μ_i is the reduced mass of the vibrating atoms
Typical range for small organic molecules: 400 to 4000 cm⁻¹
Examples: C=O stretching in ethylene carbonate ~1800 cm⁻¹; C–H stretching in dimethoxyethane ~2900 cm⁻¹</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">vibrational frequencies</rdfs:label>
        <skos:definition xml:lang="en">Vibrational frequencies are the characteristic frequencies at which atoms in a molecule oscillate around their equilibrium positions. They correspond to quantized vibrational energy levels and are the underlying quantities reported in IR and Raman spectra.</skos:definition>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/PER-CentiM"/>
        <relevance>Helps characterize molecular bonds, identify functional groups, and predict IR and Raman active modes, supporting structural analysis and understanding of molecular interactions in electrolyte systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0004001 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0004001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000023"/>
        <rdfs:comment>ρ = m / V, where m is the mass and V is the volume of the sample
Typical range for small organic electrolyte solvents: 0.8 to 1.5 g/cm³
Examples: ethylene carbonate ~1.32 g/cm³; dimethoxyethane ~0.87 g/cm³</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">density</rdfs:label>
        <skos:definition xml:lang="en">Density is the mass of a substance per unit volume. In molecular systems and liquids, it reflects how closely molecules are packed and is influenced by molecular size, interactions, and temperature.</skos:definition>
        <skos:exactMatch rdf:resource="http://semanticscience.org/resource/SIO_001406"/>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-CentiM3"/>
        <relevance>Provides insight into packing efficiency, solvent-solute interactions, and overall bulk properties of electrolytes, influencing viscosity, transport, and electrochemical performance.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0004002 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0004002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000023"/>
        <rdfs:comment>η = τ / γ̇, where τ is the shear stress and γ̇ is the shear rate
Typical range for small organic electrolyte solvents: 0.3 to 5 mPa·s
Examples: ethylene carbonate ~2.5 mPa·s; dimethoxyethane ~0.45 mPa·s</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">viscosity</rdfs:label>
        <skos:definition xml:lang="en">Viscosity is a measure of a fluid&apos;s resistance to flow. In electrolyte solutions, it reflects the internal friction between molecules and ions, influencing ion mobility and transport properties.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/pmd/co/PMD_0080174"/>
        <canonicalUnit rdf:resource="http://qudt.org/vocab/unit/MilliPA-SEC"/>
        <relevance>Determines the ease of ion transport in electrolytes, affecting diffusion, conductivity, and overall performance of electrochemical devices.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007000 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007000">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000031"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">interaction</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/SIO_010013"/>
        <skos:definition xml:lang="en">An interaction is a process in which two or more chemical entities influence each other through physical or chemical forces, without necessarily forming or breaking covalent bonds.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007001 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007000"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">hydrogen bonding</rdfs:label>
        <skos:closeMatch rdf:resource="http://id.nlm.nih.gov/mesh/D006860"/>
        <skos:definition xml:lang="en">A directional, non-covalent interaction between a hydrogen atom covalently bound to an electronegative donor atom (such as O or N) and an electronegative acceptor atom with a lone pair of electrons.</skos:definition>
        <relevance>Hydrogen bonding stabilizes molecular structures, influences solubility, affects redox stability of organic electrolytes, and can modulate the mobility of ions within the electrolyte.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007002 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007000"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">ion ion interaction</rdfs:label>
        <skos:closeMatch rdf:resource="http://semanticscience.org/resource/SIO_010496"/>
        <skos:definition xml:lang="en">Electrostatic interactions between cations and anions in solution, which may result in ion pairs or clusters.</skos:definition>
        <relevance>Ion–ion interactions influence ionic conductivity, viscosity, aggregation of salts, and electrochemical potential shifts in organic electrolytes. Strong ion pairing can reduce free ion availability for charge transport.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007003 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007000"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">ion solvent interaction</rdfs:label>
        <skos:definition xml:lang="en">Non-covalent interactions between ions and surrounding solvent molecules, typically involving coordination, dipole interactions, or hydrogen bonding.</skos:definition>
        <relevance>Ion–solvent interactions stabilize dissolved ions, modulate redox potentials, affect ion mobility, and are critical for achieving desired solubility and electrochemical performance.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007004 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007004">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007000"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">solvation</rdfs:label>
        <skos:definition xml:lang="en">The process by which solvent molecules surround and interact with a solute, forming a solvation shell through non-covalent interactions.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/REX_0000141"/>
        <relevance>Solvation governs ion stabilization, redox potential shifts, solubility, and transport properties in electrolytes. Effective solvation enhances electrolyte performance and prevents precipitation or aggregation of active species.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007005 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007004"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">hydration</rdfs:label>
        <skos:definition xml:lang="en">The specific solvation of a solute by water molecules, forming a structured hydration shell around ions or polar molecules.</skos:definition>
        <relevance>Hydration is particularly important in aqueous or partially aqueous electrolytes, affecting ion mobility, redox behavior, and chemical stability. Hydration can also influence degradation pathways for water-sensitive organic molecules.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007006 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007006">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007004"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">implicit solvation</rdfs:label>
        <skos:definition xml:lang="en">A computational representation of solvent effects in which the solvent is modeled as a continuous dielectric medium rather than as discrete molecules. The solute is placed in a cavity within the dielectric environment, and the solvent influence on the solute&apos;s electronic structure and energetics is described through polarization of the surrounding continuum.</skos:definition>
        <relevance>Implicit solvation models are widely used to estimate solvent effects on redox potentials, reaction energetics, and molecular stability in organic redox flow battery electrolytes. They allow efficient screening of redox-active molecules by approximating solvent stabilization of charged or polar species without the computational cost of explicitly simulating large numbers of solvent molecules.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007100 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007100">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000031"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">reaction</rdfs:label>
        <skos:definition xml:lang="en">A process in which one or more chemical species (reactants) are transformed into one or more different species (products) through the breaking and forming of chemical bonds.</skos:definition>
        <skos:exactMatch rdf:resource="http://semanticscience.org/resource/SIO_010345"/>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007110 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007110">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007100"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">charge transfer</rdfs:label>
        <skos:definition xml:lang="en">A chemical or electrochemical process involving the partial or complete transfer of electronic charge between donor and acceptor species without necessarily forming or breaking covalent bonds.</skos:definition>
        <relevance>Charge transfer underlies redox activity, parasitic reactions, and intermolecular interactions between electrolyte components, electrodes, and additives, directly influencing conductivity, redox kinetics, and stability.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007120 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007120">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007100"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electrochemical reaction</rdfs:label>
        <skos:definition xml:lang="en">A reaction involving the transfer of electrons between chemical species and an electrode, driven by an applied electrochemical potential. In the context of redox flow batteries, electrochemical oxidation and reduction are treated as the forward and reverse directions of a single reversible redox couple.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/REX_0000213"/>
        <relevance>Electrochemical reactions define the intended, reversible redox processes of organic electrolytes at the electrode interface, as well as unintended side reactions occurring there.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007121 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007121">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007120"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ofbo#OFBO_0007122"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ofbo#OFBO_0007130"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electrochemical oxidation</rdfs:label>
        <skos:definition xml:lang="en">The anodic half-reaction of a reversible electrochemical redox couple, in which a chemical entity loses one or more electrons at an electrode, resulting in an increase in its oxidation state.</skos:definition>
        <relevance>Electrochemical oxidation determines the upper voltage limit and oxidative stability of organic electrolytes during charge/discharge cycling, and is the counterpart of electrochemical reduction in a reversible redox couple.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007122 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007122">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007120"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ofbo#OFBO_0007131"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electrochemical reduction</rdfs:label>
        <skos:definition xml:lang="en">The cathodic half-reaction of a reversible electrochemical redox couple, in which a chemical entity gains one or more electrons at an electrode, resulting in a decrease in its oxidation state.</skos:definition>
        <relevance>Electrochemical reduction determines the lower voltage limit and reductive stability of organic electrolytes during charge/discharge cycling, and is the counterpart of electrochemical oxidation in a reversible redox couple.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007130 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007130">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007100"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">chemical oxidation</rdfs:label>
        <skos:definition xml:lang="en">A chemical reaction in which a chemical entity loses one or more electrons to another chemical species (rather than to an electrode), resulting in an increase in its oxidation state.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/REX_0000445"/>
        <relevance>Chemical, non-electrochemical oxidation of redox-active molecules or their intermediates (e.g., by dissolved oxygen or other oxidants) is a parasitic reaction that can irreversibly consume active material in redox flow battery electrolytes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007131 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007131">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007100"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">chemical reduction</rdfs:label>
        <skos:definition xml:lang="en">A chemical reaction in which a chemical entity gains one or more electrons from another chemical species (rather than from an electrode), resulting in a decrease in its oxidation state.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/REX_0000444"/>
        <relevance>Chemical, non-electrochemical reduction of redox-active molecules or their intermediates is a parasitic reaction that can irreversibly consume active material in redox flow battery electrolytes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007200 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007200">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007100"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">degradation reaction</rdfs:label>
        <skos:definition xml:lang="en">A chemical or electrochemical reaction mechanism that, in the context of redox-active electrolyte molecules, alters molecular structure or composition in a way that leads to loss of intended function, redox activity, or stability. Degradation reactions often involve bond cleavage, rearrangement, dimerization, hydrolysis, or other transformations that reduce the reversibility or performance of the species under operational conditions.</skos:definition>
        <relevance>Degradation reactions are critical for understanding the chemical and electrochemical stability of organic electrolytes. They determine the lifetime, efficiency, and safety of battery or capacitor systems.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007201 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007201">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">anthrone formation</rdfs:label>
        <skos:definition xml:lang="en">A chemical reaction in which anthraquinone or related quinone structures are reduced and subsequently rearrange to form anthrone derivatives, typically involving protonation and keto–enol type transformations.</skos:definition>
        <relevance>Anthrone formation represents an irreversible degradation pathway for quinone-based redox-active electrolytes, leading to loss of redox reversibility, decreased capacity, and reduced cycling stability.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007202 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007202">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">bromination</rdfs:label>
        <skos:definition xml:lang="en">A chemical reaction in which a bromine atom is introduced into a molecule, typically replacing a hydrogen atom or adding across a double bond, often as an undesired side reaction in brominated redox flow battery systems.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/MOP_0000551"/>
        <relevance>Bromination can represent an unwanted degradation or side reaction in organic electrolytes exposed to bromine-based active species or oxidants, altering molecular structure and electrochemical behavior.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007204 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007204">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">disproportionation</rdfs:label>
        <skos:definition xml:lang="en">A redox reaction in which a single chemical species is simultaneously oxidized and reduced, forming two products with different oxidation states.</skos:definition>
        <relevance>Disproportionation can limit the stability of intermediate redox states in organic electrolytes, reducing coulombic efficiency and impairing long-term electrochemical reversibility.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007205 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007205">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">gem diol formation</rdfs:label>
        <skos:definition xml:lang="en">A chemical reaction in which a carbonyl group reacts with water to form a geminal diol, containing two hydroxyl groups bonded to the same carbon atom.</skos:definition>
        <relevance>Gem-diol formation is relevant for carbonyl-containing electrolytes in the presence of trace water, potentially altering redox potentials, solubility, and chemical stability.</relevance>
        <rfbLiterature>https://doi.org/10.1039/C9TA03219C</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007206 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007206">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">hydrolysis</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/NCIT_C16702"/>
        <skos:definition xml:lang="en">A chemical reaction in which a molecule reacts with water, resulting in the cleavage of a covalent bond and formation of two or more products. Hydrolysis often involves nucleophilic attack by water on electrophilic centers such as esters, amides, carbonyls, or sulfonates.</skos:definition>
        <relevance>Hydrolysis is a common degradation pathway for water-sensitive organic electrolyte molecules. It can reduce solubility or redox activity of active species or generate by-products that impair conductivity or stability.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007207 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007207">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">michael addition</rdfs:label>
        <skos:definition xml:lang="en">A nucleophilic addition reaction in which a nucleophile adds to an α,β-unsaturated carbonyl or related electron-deficient system.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/RXNO_0000009"/>
        <relevance>Michael addition represents a chemical degradation pathway for conjugated organic electrolytes, especially in the presence of nucleophilic impurities or additives.</relevance>
        <rfbLiterature>https://doi.org/10.1039/C9TA03219C</rfbLiterature>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007208 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007208">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">protodesulfonation</rdfs:label>
        <skos:definition xml:lang="en">A chemical reaction in which a sulfonyl or sulfonate substituent is removed from an aromatic or aliphatic system through proton-mediated cleavage.</skos:definition>
        <relevance>Protodesulfonation can lead to loss of solubilizing or ionic groups, decreasing electrolyte solubility and causing irreversible performance degradation.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0007209 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0007209">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0007200"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">tautomerization</rdfs:label>
        <skos:definition xml:lang="en">A reversible intramolecular rearrangement involving the migration of a proton and a shift in bonding, resulting in interconvertible structural isomers known as tautomers.</skos:definition>
        <relevance>Tautomerization can influence redox potentials, proton-coupled electron transfer behavior, and chemical stability of organic electrolyte molecules.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0008000 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0008000">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000032"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">computational process</rdfs:label>
        <skos:definition xml:lang="en">A computational process is a formal algorithm or protocol used to model and predict molecular or material properties using theoretical and numerical techniques. Computational processes can range from empirical force fields to quantum chemical calculations, and are used to simulate electronic structure, thermodynamics, kinetics, or molecular dynamics.

For ab initio quantum chemical methods, standardized terminology from the MDO calculation module is used to describe the method type, level of theory, and basis sets.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0008001 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0008001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0008000"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">ab initio process</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.bioassayontology.org/bao#BAO_0002318"/>
        <skos:definition xml:lang="en">An ab initio process is a computational process based on quantum chemical methods derived directly from the principles of quantum mechanics, without the use of empirical parameters fitted to experimental data.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0008002 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0008002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0008000"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">machine learning process</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/pmd/co/PMD_0000821"/>
        <skos:definition xml:lang="en">A machine learning process is a computational process that uses statistical models and algorithms to learn patterns from data and make predictions or decisions without being explicitly programmed. In chemistry and materials science, machine learning processes can model molecular properties, potential energy surfaces, and reaction outcomes, often providing efficient approximations of quantum chemical or experimental results.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0008500 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0008500">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000032"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">experimental process</rdfs:label>
        <skos:definition xml:lang="en">An experimental process is a planned process carried out in a laboratory setting, using physical instrumentation and materials, to observe, measure, or characterize the properties or behavior of chemical entities.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/MCO_0000867"/>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0009001 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0009001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000041"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">electrolyte</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/id/86355000"/>
        <skos:definition xml:lang="en">A chemical role realized by a chemical entity when it is dissolved or dispersed within a solution and contributes to its ionic conductivity by dissociating into or otherwise supporting mobile ions.</skos:definition>
        <relevance>The electrolyte role is central to redox flow battery systems, as it underlies ionic conductivity, charge balance, and the overall ability of a solution to transport charge between electrodes.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0009002 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0009002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0009001"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">supporting electrolyte</rdfs:label>
        <skos:definition xml:lang="en">A chemical role realized by a chemical entity, typically an inert salt, when it provides ionic conductivity to a solution without participating directly in the redox reaction of interest.</skos:definition>
        <relevance>The supporting electrolyte role is important for maintaining solution conductivity and ionic strength, reducing cell resistance and migration effects, independently of the redox-active species&apos; concentration.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0009010 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0009010">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000041"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">solvent</rdfs:label>
        <skos:definition xml:lang="en">A chemical role realized by a chemical entity when it dissolves, suspends, or disperses other chemical entities, providing the liquid medium in which solvation, ion transport, and chemical reactions occur.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_46787"/>
        <relevance>The solvent role is central to electrolyte formulation, as the solvent determines solubility, viscosity, ionic conductivity, and the electrochemical window within which redox-active species and supporting electrolytes can operate.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0009011 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0009011">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0009010"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ofbo#OFBO_0009012"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">aprotic solvent</rdfs:label>
        <skos:definition xml:lang="en">A solvent role realized by a chemical entity that lacks an acidic hydrogen capable of hydrogen bonding as a donor, and therefore does not readily donate protons.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48357"/>
        <relevance>Aprotic solvents are widely used in organic redox flow battery electrolytes because they do not participate in proton-transfer side reactions, allowing wider electrochemical windows and greater compatibility with reactive or protic-sensitive redox-active species.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0009012 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0009012">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0009010"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">protic solvent</rdfs:label>
        <skos:definition xml:lang="en">A solvent role realized by a chemical entity that contains a hydrogen atom bonded to an electronegative atom, allowing it to donate protons and participate in hydrogen bonding.</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48356"/>
        <relevance>Protic solvents, such as water, are used in aqueous organic redox flow battery electrolytes and influence proton-coupled electron transfer, pH-dependent redox potentials, and hydrogen bonding interactions with dissolved species.</relevance>
    </owl:Class>
    


    <!-- https://w3id.org/ofbo#OFBO_0009020 -->


    <owl:Class rdf:about="https://w3id.org/ofbo#OFBO_0009020">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ofbo#OFBO_0000041"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">active material</rdfs:label>
        <skos:definition xml:lang="en">A chemical role realized by a chemical entity when it undergoes reversible oxidation or reduction within an electrochemical system, serving as the charge-storing species.</skos:definition>
        <relevance>The active material role identifies the molecules responsible for charge storage and energy conversion in organic redox flow batteries, making it the central role for evaluating candidate electrolyte materials.</relevance>
    </owl:Class>
    


