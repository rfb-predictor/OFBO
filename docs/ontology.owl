    <!-- http://purl.obolibrary.org/obo/BFO_0000050 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000050">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <obo:IAO_0000115 xml:lang="en">a core relation that holds between a part and its whole</obo:IAO_0000115>
        <rdfs:label xml:lang="en">part of</rdfs:label>
        <rdfs:label>part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000051 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000051">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <obo:IAO_0000115 xml:lang="en">a core relation that holds between a whole and its part</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BFO:0000051</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>has_part</oboInOwl:id>
        <oboInOwl:is_cyclic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</oboInOwl:is_cyclic>
        <rdfs:label xml:lang="en">has part</rdfs:label>
        <rdfs:label>has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000081 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000081">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:label xml:lang="en">role of</rdfs:label>
        <skos:definition xml:lang="en">A relation between a role and the independent continuant in which that role inheres.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000087 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000087">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="en">has role</rdfs:label>
        <skos:definition xml:lang="en">A relation between an independent continuant and a role that inheres in it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002351 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002351">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <obo:IAO_0000111 xml:lang="en">has member</obo:IAO_0000111>
        <obo:IAO_0000115>has member is a mereological relation between a collection and an item.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ro.owl"/>
        <rdfs:label xml:lang="en">has member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RXNO_0000423 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RXNO_0000423">
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0007100"/>
        <rdfs:range rdf:resource="https://w3id.org/ofbo#OFBO_0000011"/>
        <rdfs:label>has specified product</rdfs:label>
        <skos:definition>A relation between a planned reaction step and a molecular entity participating in that process. The creation of the molecular entity during the process is explicitly specified in the objective specification which the planned reaction step realizes the concretization of.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RXNO_0000424 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RXNO_0000424">
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0007100"/>
        <rdfs:range rdf:resource="https://w3id.org/ofbo#OFBO_0000011"/>
        <rdfs:label>has specified reactant</rdfs:label>
        <skos:definition>A relation between a planned reaction step and a molecular entity participating in that process that is not created during the process. The destruction of the molecular entity during the process is explicitly specified in the plan specification which the process realizes the concretization of.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/unit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/unit">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000011 -->


    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000011">
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000223"/>
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0000020"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ofbo#OFBO_0000010"/>
                    <rdf:Description rdf:about="https://w3id.org/ofbo#OFBO_0000031"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="en">is property of</rdfs:label>
        <skos:definition xml:lang="en">A relation between a property and a chemical entity or physico-chemical process that the property characterizes or is attributed to.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000223 -->


    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000223">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ofbo#OFBO_0000010"/>
                    <rdf:Description rdf:about="https://w3id.org/ofbo#OFBO_0000031"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ofbo#OFBO_0000020"/>
        <rdfs:label xml:lang="en">has property</rdfs:label>
        <skos:definition xml:lang="en">A relation between a chemical entity or physico-chemical process and a property that characterizes or is attributed to that entity or process.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ofbo#OFBO_0009203 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ofbo#OFBO_0009203">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0000014"/>
        <rdfs:range rdf:resource="https://w3id.org/ofbo#OFBO_0000010"/>
        <rdfs:label xml:lang="en">has chemical constituent</rdfs:label>
        <skos:definition xml:lang="en">Relates a chemical system to a chemical entity that is a constituent of that system, such as a solvent, solute, electrolyte, active material, additive, or ion.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ofbo#OFBO_0009204 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ofbo#OFBO_0009204">
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0000032"/>
        <rdfs:range rdf:resource="https://w3id.org/ofbo#OFBO_0000033"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">has process specification</rdfs:label>
        <skos:definition xml:lang="en">Relates a planned process to a process specification that describes a configured, controlled, or selected aspect of that process.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ofbo#OFBO_0009206 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ofbo#OFBO_0009206">
        <owl:inverseOf rdf:resource="https://w3id.org/ofbo#OFBO_0009207"/>
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0000011"/>
        <rdfs:range rdf:resource="https://w3id.org/ofbo#OFBO_0007100"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">has reaction</rdfs:label>
        <skos:definition xml:lang="en">Relates a molecular entity to a reaction with which it is associated. This relation does not specify whether the molecular entity is a reactant, product, oxidized form, reduced form, or another reaction participant.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ofbo#OFBO_0009207 -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ofbo#OFBO_0009207">
        <rdfs:domain rdf:resource="https://w3id.org/ofbo#OFBO_0007100"/>
        <rdfs:range rdf:resource="https://w3id.org/ofbo#OFBO_0000011"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/ofbo"/>
        <rdfs:label xml:lang="en">is reaction of</rdfs:label>
        <skos:definition xml:lang="en">Relates a reaction to a molecular entity with which it is associated. This relation does not specify whether the molecular entity is a reactant, product, oxidized form, reduced form, or another reaction participant.</skos:definition>
    </owl:ObjectProperty>
    


